# ─── Base de datos ────────────────────────────────────────────────────
DATABASE_URL="postgresql://usuario:contrasena@localhost:5434/wellbros?schema=public"

# ─── Aplicación ───────────────────────────────────────────────────────
APP_BASE_URL="https://wellbrosproperties.lat"   # en desarrollo: http://localhost:3000
# Secreto de sesión: en producción generar con `openssl rand -base64 32`
SESSION_SECRET=""

# ─── Correo (Resend) ──────────────────────────────────────────────────
# En desarrollo se usa el adaptador de consola: no se llama a Resend.
EMAIL_DRIVER="resend"          # console | resend
RESEND_API_KEY=""
RESEND_FROM="Wellbros <notificaciones@notificaciones.wellbrosproperties.lat>"
RESEND_REPLY_TO="administracion@wellbrosproperties.lat"   # debe ser un buzón REAL y atendido
RESEND_WEBHOOK_SECRET=""

# ─── WhatsApp: preparado, NO activo ───────────────────────────────────
WHATSAPP_ENABLED="false"
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_WABA_ID=""
WHATSAPP_API_VERSION="v23.0"

# ─── Semilla ──────────────────────────────────────────────────────────
# En producción NO se define: la semilla genera una contraseña aleatoria y la
# imprime una sola vez. Cámbiala en el primer inicio de sesión.
SEED_SUPERUSER_PASSWORD=""
SEED_SUPERUSER_EMAIL=""
SEED_SUPERUSER_NAME=""
