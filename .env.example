# Wellbros — plantilla de variables de entorno.
#
# ATENCIÓN, ESTO NO ES UN DETALLE DE ESTILO: los comentarios van SIEMPRE en su
# propia línea, nunca al final de una línea con valor.
#
# El motivo es que systemd lee este archivo con `EnvironmentFile=` y su lector
# solo ignora las líneas que EMPIEZAN por `#`. Un comentario al final de la línea
# queda DENTRO del valor. Es decir, esto:
#
#     EMAIL_DRIVER="resend"   # console | resend
#
# hace que la aplicación reciba `resend   # console | resend`, que no es igual a
# "resend", así que cae al adaptador de consola: no sale ni un solo correo y la
# cola marca todo como enviado. Nadie se entera hasta que alguien pregunta por
# qué no le llegó su aviso.
#
# En desarrollo no se nota, porque bash sí recorta el comentario al hacer
# `source .env`. Solo revienta en el servidor.

# ─── Base de datos ────────────────────────────────────────────────────
# En el SERVIDOR, PostgreSQL es nativo y escucha en el puerto 5432.
# El 5434 que se usa en desarrollo es del contenedor Docker, y solo porque
# el 5432 de esa máquina lo ocupa otro proyecto.
DATABASE_URL=postgresql://wellbros_user:CAMBIAR@localhost:5432/wellbros?schema=public

# ─── Aplicación ───────────────────────────────────────────────────────
# Puerto interno en el que escucha la aplicación (solo en localhost; nginx la
# expone). Cámbialo si el 3000 ya está ocupado por otra aplicación del servidor,
# y ajusta el map de deploy/nginx/wellbros.conf al mismo valor.
PORT=3000

# Ruta del binario de Node que usan los servicios. Solo hay que tocarla si el
# node del sistema es antiguo y se instaló otro aparte para no romper a las
# demás aplicaciones de la máquina.
WELLBROS_NODE=/usr/bin/node

APP_BASE_URL=https://wellbrosproperties.lat

# Generar en el servidor con:  openssl rand -base64 32
# Cambiarlo invalida todas las sesiones abiertas.
SESSION_SECRET=CAMBIAR

# ─── Correo (Resend) ──────────────────────────────────────────────────
# console = escribe los correos en .tmp/emails/ y no llama a Resend (desarrollo)
# resend  = envío real
EMAIL_DRIVER=resend

# Clave con permiso de SOLO ENVÍO y restringida al dominio.
# Su valor no se puede volver a consultar tras crearla.
RESEND_API_KEY=CAMBIAR

# El dominio verificado en Resend es la RAÍZ wellbrosproperties.lat.
# Un subdominio (notificaciones.wellbrosproperties.lat) sería OTRO dominio a
# efectos de Resend y habría que verificarlo aparte: usarlo sin verificar
# devuelve 403 y el aviso muere sin reintento.
# La parte local no necesita existir como buzón real.
RESEND_FROM="Wellbros <notificaciones@wellbrosproperties.lat>"

# Sin Reply-To por decisión del cliente: los correos avisan en su pie de que no
# se responda. Si algún día se quiere, la dirección tiene que poder RECIBIR
# correo de verdad — hoy el dominio no tiene registro MX y toda respuesta
# rebotaría.
RESEND_REPLY_TO=

# Pendiente: la ruta /api/webhooks/resend todavía no existe, así que no hay
# webhook que registrar ni secreto que poner aquí.
RESEND_WEBHOOK_SECRET=

# ─── Semilla ──────────────────────────────────────────────────────────
# Contraseña inicial de la superusuaria. Si se deja vacía, la semilla genera una
# aleatoria y la imprime UNA sola vez.
# Quien la reciba está obligado a cambiarla en su primer acceso.
SEED_SUPERUSER_PASSWORD=
SEED_SUPERUSER_EMAIL=
SEED_SUPERUSER_NAME=

# Datos de ejemplo (2 propiedades y semanas de prueba). En producción se deja
# vacío: la superusuaria crea las propiedades reales desde la aplicación.
SEED_DEMO_DATA=

# ─── WhatsApp: preparado, NO activo ───────────────────────────────────
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_API_VERSION=v23.0
