// Wellbros — esquema de datos
//
// Principios (ver docs/diseno-wellbros.html §05):
//  - Las semanas se guardan como FECHAS DE CALENDARIO (@db.Date), nunca timestamps:
//    inmune a husos horarios y horario de verano.
//  - Nada se borra físicamente: usuarios y propiedades se desactivan; reservas y
//    cesiones cambian de estado.
//  - Las invariantes críticas viven en PostgreSQL (índices parciales, CHECK,
//    columnas generadas y triggers), no solo en la aplicación. Todo eso se define
//    en migraciones SQL, porque Prisma no lo expresa: ver prisma/migrations/.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────── enums

enum UserRole {
  SUPERUSER
  USER

  @@map("user_role")
}

enum SlotStatus {
  OPEN
  RESERVED
  CLOSED

  @@map("slot_status")
}

enum ReservationStatus {
  ACTIVE
  CANCELLED

  @@map("reservation_status")
}

enum GrantStatus {
  ACTIVE
  REVOKED
  CANCELLED

  @@map("grant_status")
}

/// Para qué sirve un token de un solo uso.
///
/// POR QUÉ NO SE LLAMA «Invitation» — ni el enum ni la tabla.
/// El primer uso es la invitación de alta, pero la recuperación de contraseña
/// necesita EXACTAMENTE lo mismo: 32 bytes aleatorios, guardados solo como
/// hash, con caducidad, de un solo uso y con los anteriores invalidados al
/// emitir uno nuevo. Una tabla `invitations` habría obligado a una segunda
/// tabla gemela —con su segunda copia de la generación, el hasheo, el canje y
/// sus pruebas— y a partir de ahí las dos habrían divergido en el detalle que
/// más importa, que es el de seguridad. El propósito es una columna, no un
/// modelo distinto.
enum AccessTokenPurpose {
  INVITACION
  RESTABLECER_CONTRASENA

  @@map("access_token_purpose")
}

enum NotifChannel {
  EMAIL
  WHATSAPP

  @@map("notif_channel")
}

enum OutboxStatus {
  PENDING
  SENDING
  SENT
  FAILED
  DEAD

  @@map("outbox_status")
}

/// Qué pasó con el correo DESPUÉS de que Resend lo aceptara.
///
/// POR QUÉ UN ENUM NUEVO Y NO MÁS VALORES EN `OutboxStatus`.
/// `OutboxStatus` describe nuestro INTENTO DE ENVÍO —el ciclo de la cola:
/// PENDING → SENDING → SENT/FAILED/DEAD— y es lo que consulta el worker
/// (`WHERE status = 'PENDING'`, el rescate de los SENDING huérfanos). Lo que
/// cuenta el webhook es otra cosa y en otro eje: el aviso SÍ salió (SENT sigue
/// siendo cierto y debe seguir siéndolo) y lo que se sabe después es qué hizo
/// el destinatario con él. Meter DELIVERED o BOUNCED en el mismo enum obligaría
/// a elegir entre dos verdades simultáneas, borraría la respuesta a «¿llegamos
/// a entregárselo a Resend?» y pondría al worker a filtrar por estados que no
/// son suyos. Además `email.delivery_delayed` no es un estado de cola en
/// absoluto: es una nota al margen que no cambia nada.
///
/// Dos ejes, dos columnas: `status` es nuestro, `delivery_state` es del
/// proveedor.
enum DeliveryState {
  DELIVERED
  /// Retraso temporal en el servidor de destino. Informativo: Resend sigue
  /// intentándolo por su cuenta y nosotros NO reintentamos nada.
  DELAYED
  BOUNCED
  /// El destinatario lo marcó como correo no deseado.
  COMPLAINED
  /// Resend no consiguió enviarlo (`email.failed`).
  FAILED

  @@map("delivery_state")
}

enum ReleaseMode {
  OFFSET_DAYS
  FIXED_DAY

  @@map("release_mode")
}

enum SuperuserOverride {
  ALWAYS_EXEMPT
  AUDITED
  NEVER

  @@map("superuser_override")
}

// ─────────────────────────────────────────────────────────── usuarios

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique @db.Citext
  /// Argon2id, salvo en las cuentas dadas de alta por invitación y que todavía
  /// no la han canjeado: esas llevan un CENTINELA que no es un hash válido y
  /// contra el que ninguna contraseña puede verificar (ver SIN_CONTRASENA en
  /// src/server/admin/users.ts). Nacer sin contraseña utilizable es el punto
  /// entero de la invitación: la primera que existe la escribe su dueña.
  passwordHash String   @map("password_hash")
  fullName     String   @map("full_name")
  /// E.164 (+52...). Preparado para WhatsApp; nulo mientras no haya número.
  phone        String?  @db.VarChar(20)
  whatsappOptIn Boolean @default(false) @map("whatsapp_opt_in")
  role         UserRole @default(USER)
  /// 'light' | 'dark' | 'system'
  theme        String   @default("system") @db.VarChar(10)
  isActive     Boolean  @default(true) @map("is_active")
  /// La contraseña vigente la eligió OTRA persona (la semilla, o un alta desde
  /// Configuración con contraseña temporal). Mientras sea true, el layout del
  /// grupo (app) no deja navegar a ninguna pantalla que no sea
  /// /cambiar-contrasena. Lo apaga `changeOwnPassword`, en su transacción.
  mustChangePassword Boolean @default(false) @map("must_change_password")

  /// Su correo REBOTÓ de forma permanente (la dirección no existe o el dominio
  /// la rechaza para siempre): a esta persona ya no se le puede escribir.
  /// Lo escribe el webhook de Resend, nunca la aplicación.
  ///
  /// Es un timestamp y no un booleano porque la pregunta que se hace la
  /// superusuaria cuando alguien no se entera de nada no es «¿rebota?» sino
  /// «¿desde cuándo?»: con la fecha delante sabe si el problema empezó antes o
  /// después del aviso que esa persona dice no haber recibido. Nulo = se le
  /// puede escribir.
  emailBouncedAt    DateTime? @map("email_bounced_at") @db.Timestamptz(6)
  /// Marcó uno de nuestros avisos como correo no deseado. A partir de aquí solo
  /// se le mandan los avisos ESENCIALES: seguir insistiendo con el movimiento
  /// de la casa quema la reputación del dominio para todos los demás.
  emailComplainedAt DateTime? @map("email_complained_at") @db.Timestamptz(6)

  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  sessions          Session[]
  accessTokens      AccessToken[]      @relation("AccessTokenSubject")
  accessTokensIssued AccessToken[]     @relation("AccessTokenIssuer")
  slotsCreated      WeekSlot[]         @relation("SlotCreatedBy")
  reservations      Reservation[]      @relation("ReservationOwner")
  reservationsCancelled Reservation[]  @relation("ReservationCancelledBy")
  grantsGiven       DayGrant[]         @relation("GrantGrantor")
  grantsReceived    DayGrant[]         @relation("GrantGrantee")
  maintenanceNotes  MaintenanceNote[]
  auditEntries      AuditLog[]
  outboxMessages    NotificationOutbox[]
  policiesUpdated   BookingPolicy[]

  @@index([isActive])
  @@map("users")
}

/// Sesión con token opaco: en la base solo vive el HASH del token,
/// nunca el token mismo (que va en la cookie httpOnly).
model Session {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  tokenHash  String   @unique @map("token_hash")
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  ip         String?  @db.VarChar(64)
  userAgent  String?  @map("user_agent")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Token de un solo uso para abrir o recuperar una cuenta.
///
/// Mismo criterio que `Session`: en la base vive SOLO el SHA-256 del token,
/// nunca el token. Un volcado de esta tabla no permite entrar como nadie ni
/// fabricar un enlace válido. Y basta SHA-256 (no Argon2) por el mismo motivo
/// que allá: no es una contraseña elegida por una persona sino 256 bits
/// aleatorios, contra los que no hay diccionario; lo que se busca es que el
/// valor robado de la base no sea reutilizable, no frenar la fuerza bruta.
///
/// El ciclo de vida se lee en tres columnas nulas, y cada una responde una
/// pregunta distinta que a la administración le interesa poder separar:
///   · `usedAt`       — alguien lo canjeó (y por tanto ya entró).
///   · `supersededAt` — lo dejamos obsoleto al emitir otro para esa persona y
///                      propósito. No es lo mismo que caducar ni que usarse.
///   · `expiresAt`    — se le acabó el plazo sin que nadie lo tocara.
///
/// La regla «solo puede haber UN token vigente por persona y propósito» no es
/// una convención del código: es un índice único PARCIAL sobre
/// (user_id, purpose) WHERE used_at IS NULL AND superseded_at IS NULL, que
/// Prisma no sabe expresar y que se crea en la migración. Así, aunque alguien
/// escribiera mañana un `create` que olvide invalidar los anteriores, la base
/// lo rechaza en vez de dejar dos enlaces buenos circulando.
model AccessToken {
  id        String             @id @default(uuid()) @db.Uuid
  userId    String             @map("user_id") @db.Uuid
  purpose   AccessTokenPurpose
  /// SHA-256 en hexadecimal del token que viaja en el enlace.
  tokenHash String             @unique @map("token_hash")
  expiresAt DateTime           @map("expires_at") @db.Timestamptz(6)

  usedAt       DateTime? @map("used_at") @db.Timestamptz(6)
  supersededAt DateTime? @map("superseded_at") @db.Timestamptz(6)

  /// Quién lo emitió. Nulo en los que nadie pide a mano (una futura
  /// recuperación de contraseña la inicia la propia persona, sin actor).
  createdById String?  @map("created_by") @db.Uuid
  ip          String?  @db.VarChar(64)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user      User  @relation("AccessTokenSubject", fields: [userId], references: [id], onDelete: Cascade)
  createdBy User? @relation("AccessTokenIssuer", fields: [createdById], references: [id])

  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("access_tokens")
}

// ─────────────────────────────────────────────────────── propiedades

model Property {
  id        String   @id @default(uuid()) @db.Uuid
  /// Texto libre: es lo que muestra el combo sobre el calendario.
  name      String   @unique
  /// Color de identidad: uno de los ocho de src/lib/property-color.ts.
  /// Tiñe el cromo del calendario, nunca los estados de la semana.
  color     String   @default("indigo") @db.VarChar(20)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  slots            WeekSlot[]
  maintenanceNotes MaintenanceNote[]
  policies         BookingPolicy[]

  @@index([isActive])
  @@map("properties")
}

// ──────────────────────────────────────────────────── slots de semana

model WeekSlot {
  id         String     @id @default(uuid()) @db.Uuid
  propertyId String     @map("property_id") @db.Uuid
  /// Siempre viernes (CHECK en migración: EXTRACT(ISODOW) = 5).
  startDate  DateTime   @map("start_date") @db.Date
  /// Jueves. Columna GENERADA en la base (start_date + 6): ver migración.
  endDate    DateTime   @default(dbgenerated()) @map("end_date") @db.Date
  /// Mes al que pertenece la semana para la ventana de apertura.
  /// Columna GENERADA (date_trunc('month', start_date + anchor_offset)): ver migración.
  anchorMonth DateTime  @default(dbgenerated()) @map("anchor_month") @db.Date
  status     SlotStatus @default(OPEN)
  createdById String    @map("created_by") @db.Uuid
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  property     Property      @relation(fields: [propertyId], references: [id])
  createdBy    User          @relation("SlotCreatedBy", fields: [createdById], references: [id])
  reservations Reservation[]

  @@unique([propertyId, startDate])
  @@index([propertyId, anchorMonth, startDate])
  @@index([propertyId, status, startDate])
  @@map("week_slots")
}

// ──────────────────────────────────────────────────────────── reservas

model Reservation {
  id       String            @id @default(uuid()) @db.Uuid
  slotId   String            @map("slot_id") @db.Uuid
  userId   String            @map("user_id") @db.Uuid
  status   ReservationStatus @default(ACTIVE)

  /// Política de ventana vigente cuando se creó: permite explicar años
  /// después bajo qué regla se reservó.
  policyId       String?  @map("policy_id") @db.Uuid
  /// La creó el superusuario saltándose la ventana de apertura.
  windowOverride Boolean  @default(false) @map("window_override")
  overrideReason String?  @map("override_reason")

  cancelledAt   DateTime? @map("cancelled_at") @db.Timestamptz(6)
  cancelledById String?   @map("cancelled_by") @db.Uuid
  cancelReason  String?   @map("cancel_reason")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  slot        WeekSlot       @relation(fields: [slotId], references: [id])
  user        User           @relation("ReservationOwner", fields: [userId], references: [id])
  cancelledBy User?          @relation("ReservationCancelledBy", fields: [cancelledById], references: [id])
  policy      BookingPolicy? @relation(fields: [policyId], references: [id])
  dayGrants   DayGrant[]

  // La unicidad real ("un slot, una reserva ACTIVA") es un índice único PARCIAL
  // que Prisma no expresa: se crea en la migración.
  @@index([userId, status])
  @@index([slotId])
  @@map("reservations")
}

// ─────────────────────────────────────────────────── cesiones de días

model DayGrant {
  id            String      @id @default(uuid()) @db.Uuid
  reservationId String      @map("reservation_id") @db.Uuid
  /// Dueño de la reserva al momento de ceder (snapshot).
  grantorUserId String      @map("grantor_user_id") @db.Uuid
  granteeUserId String      @map("grantee_user_id") @db.Uuid
  grantDate     DateTime    @map("grant_date") @db.Date
  /// REVOKED = el dueño la retiró. CANCELLED = cayó al cancelar la reserva.
  status        GrantStatus @default(ACTIVE)
  endedAt       DateTime?   @map("ended_at") @db.Timestamptz(6)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  reservation Reservation @relation(fields: [reservationId], references: [id])
  grantor     User        @relation("GrantGrantor", fields: [grantorUserId], references: [id])
  grantee     User        @relation("GrantGrantee", fields: [granteeUserId], references: [id])

  // Unicidad parcial (un día no se cede dos veces) + validación cruzada
  // por trigger: ver migración.
  @@index([granteeUserId, status, grantDate])
  @@index([reservationId])
  @@map("day_grants")
}

// ───────────────────────────────────────────── notas de mantenimiento

model MaintenanceNote {
  id          String   @id @default(uuid()) @db.Uuid
  propertyId  String   @map("property_id") @db.Uuid
  startDate   DateTime @map("start_date") @db.Date
  endDate     DateTime @map("end_date") @db.Date
  note        String
  createdById String   @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  property  Property @relation(fields: [propertyId], references: [id])
  createdBy User     @relation(fields: [createdById], references: [id])

  @@index([propertyId, startDate])
  @@map("maintenance_notes")
}

// ────────────────────────────────────────── política de reserva (ventana)

/// Versionada: nunca se hace UPDATE destructivo. La fila vigente es la de
/// mayor `effectiveFrom` <= now(), prefiriendo la específica de la propiedad
/// sobre la global (propertyId = null).
model BookingPolicy {
  id         String  @id @default(uuid()) @db.Uuid
  /// null = política global por defecto.
  propertyId String? @map("property_id") @db.Uuid

  timeZone           String            @default("America/Mexico_City") @map("time_zone")
  mode               ReleaseMode       @default(OFFSET_DAYS)
  /// Días exactos de anticipación (modo OFFSET_DAYS).
  bookingWindowDays  Int               @default(15) @map("booking_window_days")
  /// Día fijo del mes (modo FIXED_DAY).
  releaseDayOfMonth  Int               @default(15) @map("release_day_of_month")
  releaseHour        Int               @default(0) @map("release_hour")
  releaseMinute      Int               @default(0) @map("release_minute")
  /// 0 = la semana cuenta en el mes de su viernes de inicio (decisión confirmada).
  /// 3 = cuenta en el mes donde caen más días. 6 = exige la semana completa.
  anchorOffsetDays   Int               @default(0) @map("anchor_offset_days")
  allowInProgressWeek Boolean          @default(true) @map("allow_in_progress_week")
  visibleHorizonMonths Int             @default(6) @map("visible_horizon_months")
  superuserOverride  SuperuserOverride @default(ALWAYS_EXEMPT) @map("superuser_override")

  effectiveFrom DateTime @default(now()) @map("effective_from") @db.Timestamptz(6)
  updatedById   String?  @map("updated_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  property     Property?     @relation(fields: [propertyId], references: [id])
  updatedBy    User?         @relation(fields: [updatedById], references: [id])
  reservations Reservation[]

  @@index([propertyId, effectiveFrom])
  @@map("booking_policy")
}

// ───────────────────────────────────────────────── bitácora (oculta)

/// Append-only: al rol de base de datos de la aplicación se le revocan
/// UPDATE y DELETE sobre esta tabla (ver migración).
model AuditLog {
  id          BigInt   @id @default(autoincrement())
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id") @db.Uuid
  details     Json     @default("{}")
  ip          String?  @db.VarChar(64)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor User? @relation(fields: [actorUserId], references: [id])

  @@index([createdAt(sort: Desc)])
  @@index([entityType, entityId])
  @@index([actorUserId])
  @@map("audit_log")
}

// ──────────────────────────────────────────────────── notificaciones

model NotificationChannelConfig {
  channel   NotifChannel @id
  isEnabled Boolean      @map("is_enabled")
  /// Datos NO sensibles (remitente, nombre visible, plantillas).
  /// Las credenciales viven en variables de entorno, nunca aquí.
  config    Json         @default("{}")
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("notification_channels")
}

/// Patrón outbox: el aviso se encola en la MISMA transacción que el evento
/// de negocio. Un worker aparte lo envía con reintentos.
model NotificationOutbox {
  id                String       @id @default(uuid()) @db.Uuid
  channel           NotifChannel
  recipientUserId   String       @map("recipient_user_id") @db.Uuid
  /// Snapshot de la dirección al encolar.
  recipientAddress  String       @map("recipient_address")
  eventType         String       @map("event_type")
  payload           Json
  /// Asunto y cuerpo CONGELADOS en el primer intento: los reintentos deben
  /// enviar exactamente lo mismo o Resend responde 409 al deduplicar.
  renderedSubject   String?      @map("rendered_subject")
  renderedHtml      String?      @map("rendered_html")
  renderedText      String?      @map("rendered_text")
  /// Clave de idempotencia enviada a Resend: evento/entidad/usuario.
  dedupeKey         String       @unique @map("dedupe_key")
  status            OutboxStatus @default(PENDING)
  attempts          Int          @default(0)
  /// Envío diferido: usado para anunciar un mes justo al abrirse.
  scheduledFor      DateTime     @default(now()) @map("scheduled_for") @db.Timestamptz(6)
  nextAttemptAt     DateTime     @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  lastError         String?      @map("last_error")
  providerMessageId String?      @map("provider_message_id")
  sentAt            DateTime?    @map("sent_at") @db.Timestamptz(6)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  /// Desenlace informado por el webhook de Resend. Nulo mientras no se sepa
  /// nada: ni «se entregó» ni «no se entregó», simplemente aún no ha llegado
  /// ningún aviso del proveedor (o el canal no es correo).
  deliveryState     DeliveryState? @map("delivery_state")
  /// Motivo en las palabras del proveedor: el tipo y subtipo del rebote, o la
  /// razón del fallo. Es lo que hace accionable un BOUNCED —«buzón lleno» y
  /// «la dirección no existe» piden cosas distintas—.
  deliveryDetail    String?        @map("delivery_detail")
  /// Cuándo se supo. No es `sent_at`: entre entregar y rebotar pueden pasar
  /// días.
  deliveryUpdatedAt DateTime?      @map("delivery_updated_at") @db.Timestamptz(6)

  recipient User @relation(fields: [recipientUserId], references: [id])

  @@index([status, scheduledFor, nextAttemptAt])
  @@index([providerMessageId])
  // Para la pantalla de «avisos que no llegaron», que es el motivo entero de
  // tener estas columnas.
  @@index([deliveryState])
  @@map("notification_outbox")
}

/// Deduplicación de webhooks de Resend, que se entregan al menos una vez.
model WebhookEvent {
  id         String   @id @default(uuid()) @db.Uuid
  svixId     String   @unique @map("svix_id")
  eventType  String   @map("event_type")
  payload    Json
  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz(6)

  @@map("webhook_events")
}
