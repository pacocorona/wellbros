[Unit]
Description=Wellbros (worker de la cola de notificaciones)
After=network.target postgresql.service wellbros.service
Wants=postgresql.service

[Service]
Type=simple
User=wellbros
Group=wellbros
WorkingDirectory=/srv/wellbros/app
# Ver la nota de wellbros.service sobre WELLBROS_NODE.
Environment=WELLBROS_NODE=/usr/bin/node
EnvironmentFile=/srv/wellbros/shared/.env
# Proceso aparte de la web: un fallo de envio de correo no debe afectar
# a las peticiones de los usuarios, ni al reves.
# Ruta literal: ver la nota de wellbros.service.
ExecStart=/srv/wellbros/bin/run-worker.sh
Restart=always
RestartSec=15

NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/srv/wellbros
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
